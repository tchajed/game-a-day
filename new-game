#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <game-directory>" >&2
  exit 1
fi

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
game_dir="$1"

if [[ -e "$game_dir" ]]; then
  echo "Error: '$game_dir' already exists" >&2
  exit 1
fi

mkdir -p "$game_dir"
cp "$repo_dir/AGENTS.template.md" "$game_dir/AGENTS.md"
cat >"$game_dir/README.md" <<'EOF'
# Game title

EOF

# Seed the legacy text lockfile format so newer local Bun releases preserve
# compatibility with the Bun 1.2.x version used by Cloudflare Pages.
cat >"$game_dir/bun.lock" <<'EOF'
{
  "lockfileVersion": 1,
  "configVersion": 1,
  "workspaces": {
    "": {
      "name": "new-game"
    }
  },
  "packages": {},
}
EOF

echo "Created game directory: $game_dir"
