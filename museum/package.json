{
  "name": "museum-of-ordinary-things",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun run build && playwright test",
    "test:wall-snapshots": "bun run build && playwright test tests/wall-snapshots.spec.ts",
    "update:wall-snapshots": "bun run build && playwright test tests/wall-snapshots.spec.ts --update-snapshots",
    "art:night-garden": "bun scripts/generate-night-garden.ts --all"
  },
  "dependencies": {
    "playcanvas": "^2.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
